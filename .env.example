# Plickify Tools site — environment variables
#
# NOTE: the browser app needs NO env file anymore — the Firebase web config
# is public and baked into src/lib/firebase.ts.
#
# The variables below are SERVER-SIDE only. Set them in the Vercel dashboard:
#   Project → Settings → Environment Variables  (Production + Preview)

# Full JSON of the Firebase service-account key
# (Firebase console → Project settings → Service accounts → Generate new private key).
# Paste the entire file contents as the value.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Long random string used to sign activation tokens (same one forever).
# Generate once:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_TOKEN_SECRET=change-me-to-a-long-random-hex-string

# Optional — GitHub personal access token (repo scope) so private-repo
# release assets can be resolved to short-lived download URLs.
# Public release URLs work without it.
GITHUB_TOKEN=
